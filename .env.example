# ========================================================
# VARIABLES DE ENTORNO - NEXT.JS & SUPABASE
# ========================================================

# Supabase (Obtén estos datos en: Configuración de Proyecto > API en supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-aqui

# Credenciales de Email (Opcional - para enviar correos directamente vía Nodemailer/Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@serviciosmoran.com
SMTP_PASS=tu-contraseña-de-aplicacion-gmail

# Clave secreta de sesión
SESSION_SECRET=servicios-moran-super-secret-key-2026
